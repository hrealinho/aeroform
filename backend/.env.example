DATABASE_URL=sqlite:///./endurance_ai.db
STORAGE_PATH=./data/raw
REDIS_URL=redis://localhost:6379/0
ASYNC_TASKS=false
APP_SECRET=replace-with-a-long-random-secret
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/api/v1/strava/callback
STRAVA_FRONTEND_REDIRECT_URI=http://localhost:3000/imports?strava=connected
STRAVA_API_BASE=https://www.strava.com/api/v3
STRAVA_OAUTH_BASE=https://www.strava.com/oauth
STRAVA_WEBHOOK_VERIFY_TOKEN=replace-me
STRAVA_SYNC_STREAMS=false

# AI coach.
#   local     - deterministic planner, no credentials, always available
#   anthropic - Claude refines the deterministic plan (recommended)
#   http_json - vendor-neutral JSON gateway
AI_PROVIDER=local
AI_MODEL=claude-opus-5
# For AI_PROVIDER=anthropic. The SDK also reads ANTHROPIC_API_KEY directly.
# AI_API_KEY=sk-ant-...
# For AI_PROVIDER=http_json, configure a compatible JSON endpoint.
# AI_ENDPOINT=https://your-ai-gateway.example/v1/endurance
# AI_API_KEY=...
AI_TIMEOUT_S=30

# Fitness/fatigue EWMA time constants, in days.
FITNESS_TAU_DAYS=42
FATIGUE_TAU_DAYS=7
