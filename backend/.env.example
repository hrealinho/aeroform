DATABASE_URL=sqlite:///./endurance_ai.db
STORAGE_PATH=./data/raw
REDIS_URL=redis://localhost:6379/0
ASYNC_TASKS=false
APP_SECRET=replace-with-a-long-random-secret
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/api/v1/strava/callback
STRAVA_FRONTEND_REDIRECT_URI=http://localhost:3000/imports?strava=connected
STRAVA_API_BASE=https://www.strava.com/api/v3
STRAVA_OAUTH_BASE=https://www.strava.com/oauth
STRAVA_WEBHOOK_VERIFY_TOKEN=replace-me
STRAVA_SYNC_STREAMS=false

# AI coach. Local is deterministic and requires no key.
AI_PROVIDER=local
AI_MODEL=endurance-planner-v0.4
# For AI_PROVIDER=http_json, configure a compatible JSON endpoint.
# AI_ENDPOINT=https://your-ai-gateway.example/v1/endurance
# AI_API_KEY=...
AI_TIMEOUT_S=30
