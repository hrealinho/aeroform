# Copy to .env beside docker-compose.yml. Compose reads this file automatically for
# ${VAR} substitution, so the values reach the containers without needing an export in
# whichever shell happens to run `docker compose up`.
#
# .env is gitignored. Never commit real keys.

APP_SECRET=use-a-long-random-secret

# --- Strava ---------------------------------------------------------------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=another-random-secret
# Required for the power curve and measured descent. Set BEFORE the first sync:
# streams cannot be backfilled by a recompute, only by re-importing.
STRAVA_SYNC_STREAMS=true

# --- AI provider ----------------------------------------------------------
# local | anthropic | openai | http_json
AI_PROVIDER=local

# For AI_PROVIDER=openai
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o
# OPENAI_API_KEY=sk-proj-...

# For AI_PROVIDER=anthropic
# AI_PROVIDER=anthropic
# AI_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...
